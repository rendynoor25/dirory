# Dirory — Caddy reverse proxy with automatic HTTPS (brief §109).
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, as soon as
# the DNS name in $DOMAIN resolves to this server and port 80/443 are open. There
# is no certificate configuration to do by hand.
#
# The domain is a variable so the same file works for any hostname:
#   DOMAIN=admin.dirory.com docker compose up -d

{$DOMAIN} {
	encode zstd gzip

	# Reverse proxy to the Next.js container. `web` is the compose service name,
	# resolved on the compose network.
	reverse_proxy web:3000

	# Security headers (OWASP A05). Caddy adds HSTS itself once TLS is active.
	#
	# The CSP is deliberately limited to directives that cannot break the app:
	# object-src, base-uri, frame-ancestors and form-action stop the classic
	# injection tricks without restricting where scripts, styles or images may be
	# loaded from. A script-src/style-src policy is the next step, but it has to be
	# tested against the Midtrans Snap payment page first — a wrong source there
	# silently breaks paying, so it is not worth guessing at.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		X-Permitted-Cross-Domain-Policies none
		# Keeps Google sign-in popups working, unlike plain `same-origin`.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		# NOTE: no `default-src` here, deliberately.
		#
		# `default-src` is the fallback for every fetch directive that is not
		# named, so adding it silently became a script-src and style-src. Next
		# ships ~18 inline bootstrap scripts and React writes inline styles, so
		# `default-src 'self'` blocked hydration and the whole app went dead in
		# the browser while still answering HTTP 200 on the server.
		#
		# Only the directives that cannot restrict loading are listed, so a
		# mistake here cannot take the site down. Adding script-src/style-src is
		# a deliberate future step, to be tested against the Midtrans Snap page.
		Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
		-Server
	}

	# Health endpoint is useful unauthenticated; keep it cheap and uncached.
	@health path /api/health
	header @health Cache-Control "no-store"

	# Access logs to stdout (visible with `docker compose logs caddy`).
	log {
		output stdout
		format console
	}
}

# Optional: redirect www to the bare domain. Uncomment and set WWW_DOMAIN if you
# point www.dirory.com here too, so both names serve one canonical URL.
# {$WWW_DOMAIN} {
#	redir https://{$DOMAIN}{uri} permanent
# }
