# Dirory — deployment environment (M5 / brief §110).
#
# NAMES ONLY, no real values. Copy to `.env` on the server and fill it in:
#   cp .env.example .env && nano .env && chmod 600 .env
#
# Treat .env as a secret file. It holds the service-role key, which bypasses all
# Row Level Security. Never commit it, never paste it into chat.

# --- Public (baked into the client bundle at BUILD time) --------------------
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_…). Safe in the browser by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served. Drives auth redirects and absolute links.
# One domain for everything: public pages AND the back-office at /admin.
NEXT_PUBLIC_SITE_URL=https://dirory.com

# --- Server-only (read at RUNTIME; never reaches the browser) ---------------
# The SECRET key (sb_secret_…), i.e. the old service_role. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment -------------------------------------------------------------
# The public hostname Caddy gets a certificate for. Must resolve to this server.
DOMAIN=dirory.com

# --- Payments: Midtrans Snap (server-only, read at RUNTIME) -----------------
# Dashboard -> Settings -> Access Keys. The sandbox keys start with "SB-Mid-".
# The SERVER key authorises charges: never expose it to the browser.
MIDTRANS_SERVER_KEY=
# The CLIENT key is public by design (Snap.js needs it), but it is read on the
# server and passed to the page, so it is not baked into the client bundle.
MIDTRANS_CLIENT_KEY=
# "false" (or unset) = sandbox, "true" = live transactions.
MIDTRANS_IS_PRODUCTION=false
# Optional: restrict which methods Snap offers. Comma-separated.
#   bsi_va        = BSI Virtual Account (payable only via the BYOND by BSI app)
#   bca_va, bni_va, bri_va, permata_va, gopay, shopeepay, qris, other_va
# Leave empty to offer everything the merchant account has enabled. Setting a
# single value sends the payer straight to that method.
MIDTRANS_ENABLED_PAYMENTS=

# --- Manual bank transfer (server-only, read at RUNTIME) --------------------
# Shown on every unpaid invoice as the alternative to paying online. Leave blank
# to hide the box. These values ARE shown to vendors, which is the point of a
# payment destination - do not put anything secret here.
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_BANK_HOLDER=

# Register this URL as the Payment Notification URL in the Midtrans dashboard:
#   https://<DOMAIN>/api/payments/midtrans/webhook
