# Public Supabase values — safe to expose to the browser.
# Find them in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER commit this or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Where Supabase should send the magic-link callback (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=https://dirory.com

# Hostname that serves the admin back-office. On this host "/" shows the admin
# dashboard; every other host shows the public architect pages. Optional; it
# defaults to admin.dirory.com.
NEXT_PUBLIC_ADMIN_HOST=admin.dirory.com
