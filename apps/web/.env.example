# Public Supabase values — safe to expose to the browser.
# Find them in Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER commit this or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Where Supabase should send the magic-link callback (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=https://dirory.com

# Payments: Midtrans Snap. All server-only and read at RUNTIME, so the client
# key is not baked into the browser bundle.
#   MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
#   MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
#   MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Optional: restrict Snap's methods, e.g. MIDTRANS_ENABLED_PAYMENTS=bsi_va
MIDTRANS_ENABLED_PAYMENTS=

# Manual bank transfer shown on unpaid invoices (server-only, runtime).
#   BILLING_BANK_NAME=Bank Syariah Indonesia (BSI)
#   BILLING_BANK_ACCOUNT=1234567890
#   BILLING_BANK_HOLDER=Your Name
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_BANK_HOLDER=

# Extra accounts allowed to see /pricing regardless of domain (comma-separated).
# The founder's address is built in.
PRICING_ALLOWED_EMAILS=
